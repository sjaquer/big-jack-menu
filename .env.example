# ERP / webhook de pedidos (solo servidor)
# WEBHOOK_ORDERS_URL tiene prioridad; si no existe se usa ERP_BASE_URL + /api/webhooks/orders
ERP_BASE_URL=https://bigjack-rp.vercel.app
WEBHOOK_ORDERS_URL=https://bigjack-rp.vercel.app/api/webhooks/orders
WEBHOOK_MENU_SECRET=your_webhook_secret_here

# Libro de Reclamaciones (solo servidor)
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_app_password_here
RECIPIENT_EMAIL=admin@yourdomain.com
# Opcional: canal alternativo servidor-a-servidor
FORMSPREE_URL=

# URL pública del sitio (metadata, sitemap, robots)
NEXT_PUBLIC_BASE_URL=https://bigjack.vercel.app

# Google Search Console: define el código solo si verificas un dominio.
# Si queda vacío, no se publica la meta de verificación.
GOOGLE_SITE_VERIFICATION=

# Google Tag Manager: ID del contenedor (GTM-XXXXXXX). Vacío = no se carga GTM.
NEXT_PUBLIC_GTM_ID=GTM-W8X3K2L7

# Google Analytics 4: ID de medición (G-XXXXXXXXXX). Si no se define, se usa
# G-YQP6YH6PR4 (app/lib/site.js). Los eventos evitan el doble conteo si usas GTM.
NEXT_PUBLIC_GA_ID=

# Cloudflare Turnstile (anti-bots del checkout y de /api/online-orders)
# La clave del sitio es pública. La secreta va SOLO en Vercel (nunca en el repo).
# En desarrollo, si están vacías, se usan las claves de prueba de Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFumLMQhYm1EFauY
TURNSTILE_SECRET_KEY=0x4AAAAAAFumLK1bG7k02yESqU9xI52uBMY
