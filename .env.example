# ERP / webhook de pedidos (solo servidor)
# WEBHOOK_ORDERS_URL tiene prioridad; si no existe se usa ERP_BASE_URL + /api/webhooks/orders
ERP_BASE_URL=https://bigjack-rp.vercel.app
WEBHOOK_ORDERS_URL=https://bigjack-rp.vercel.app/api/webhooks/orders
WEBHOOK_MENU_SECRET=your_webhook_secret_here

# Libro de Reclamaciones (solo servidor)
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_app_password_here
RECIPIENT_EMAIL=admin@yourdomain.com
# Opcional: canal alternativo servidor-a-servidor
FORMSPREE_URL=

# URL pública del sitio (metadata, sitemap, robots)
NEXT_PUBLIC_BASE_URL=https://bigjack.vercel.app
